  "type": "module",
  "description": "An SMS-first back-office agent for creative professionals.",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server.ts",
