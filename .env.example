# simulator (local phone UI) or twilio
SMS_MODE=simulator
# claude-cli (local, uses your Claude subscription), anthropic (production), or mock (tests)
LLM_PROVIDER=claude-cli
PORT=8787
PUBLIC_URL=http://localhost:8787
DB_PATH=data/studio.db
STUDIO_DISPLAY_NUMBER=(555) 555-0100

# Production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
